{
  "name": "maplibre-ui-translations",
  "version": "0.5.0",
  "description": "Community translations for the default MapLibre UI.",
  "author": "Sam Woodcock",
  "license": "MIT",
  "type": "module",
  "main": "dist/maplibre-ui-translations.umd.cjs",
  "module": "dist/maplibre-ui-translations.js",
  "types": "dist/maplibre-ui-translations.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/maplibre-ui-translations.d.ts",
        "default": "./dist/maplibre-ui-translations.js"
      },
      "require": {
        "types": "./dist/maplibre-ui-translations.d.cts",
        "default": "./dist/maplibre-ui-translations.umd.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:umd && npm run build:cjs-types",
    "build:esm": "tsc",
    "build:umd": "rolldown -c",
    "build:cjs-types": "node scripts/emit-cjs-types.mjs",
    "check:locales": "node test/check-locales.mjs",
    "docs:locales": "node scripts/locale-table.mjs --write",
    "demo": "npm run build && echo '\\nDemo: http://localhost:4173/test/\\n' && npx --yes serve . --listen 4173",
    "test": "npm run build && npm run check:locales && node scripts/locale-table.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "maplibre",
    "maplibre-gl",
    "translations",
    "i18n",
    "localization",
    "maps"
  ],
  "devDependencies": {
    "maplibre-gl": "^6.3.0",
    "rolldown": "1.0.0-beta.42",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "maplibre-gl": ">=2.0.0"
  }
}